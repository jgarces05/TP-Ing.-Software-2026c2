# Copiá este archivo a .env.local y completá los dos valores.
#
# Mientras estas dos variables estén vacías, la aplicación arranca igual y usa
# los datos de ejemplo que están en src/lib/semilla.js, guardados en el navegador.
# Eso permite que todo el equipo clone y levante el proyecto sin esperar a que
# alguien reparta las claves.
#
# Los valores salen de Supabase: Project Settings -> API.
# La clave anónima es pública por diseño (viaja al navegador). La service_role
# NO va acá ni en ningún archivo del repo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
